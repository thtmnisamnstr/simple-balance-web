{
  "name": "simple-balance-web",
  "version": "0.1.0",
  "private": true,
  "description": "The marketing site for Simple Balance, at smpl.money",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.3.5",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-smartypants": "^3.0.3",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
